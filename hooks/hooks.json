{
  "description": "Question-answering discipline and em-dash enforcement",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/graphify_context.js\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/docs_first_guard.py\"",
            "timeout": 5,
            "statusMessage": "Reminding the model to verify docs, not memory"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/classify_question.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/require_answer_questions_skill.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/rule_engine.py\" UserPromptSubmit"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block_pending_question.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "agent",
            "if": "Bash(git push *)",
            "prompt": "A Bash tool call is about to run `git push`. Hook input: $ARGUMENTS\n\nRead the transcript file at the input's transcript_path and find the user's most recent message(s) in the current turn only. Decide whether that message explicitly and unambiguously told the assistant to run `git push` right now. Authorization from an earlier turn or an earlier session never carries over, only the current turn's own message can authorize this specific push.\n\nIf there is any doubt, ambiguity, vagueness, or the user did not clearly and explicitly say to push right now, you MUST respond with ok: false. Only respond ok: true when the user's current message unmistakably authorizes pushing now. When uncertain, always choose false.\n\nRespond with JSON: {\"ok\": true} to allow the push, or {\"ok\": false, \"reason\": \"<why, plain and short>\"} to deny it.",
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/rule_engine.py\" PreToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/block_emdash_turn.py\""
          }
        ]
      }
    ]
  }
}
