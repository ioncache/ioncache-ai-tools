{
  "description": "Ordered shared hooks with Codex patch normalization",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" PreToolUse",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" Stop",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" PostToolUse", "timeout": 30}]}
    ],
    "PreCompact": [
      {"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" PreCompact", "timeout": 10}]}
    ],
    "SessionStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" SessionStart", "timeout": 10}]}
    ],
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" SessionEnd", "timeout": 3}]}
    ],
    "SubagentStart": [
      {"hooks": [{"type": "command", "command": "python3 \"${PLUGIN_ROOT}/hooks/scripts/codex_adapter.py\" SubagentStart", "timeout": 10}]}
    ]
  }
}
