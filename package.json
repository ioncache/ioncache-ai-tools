{
  "name": "ioncache-ai-tools",
  "private": true,
  "description": "Contributor tooling for ioncache-ai-tools",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "husky",
    "test:settings-ui": "claude plugin test .",
    "release": "node scripts/release.js",
    "release:check": "node scripts/release.js --check",
    "test:responses": "node --test hooks/response-validation/response.test.mjs && claude plugin test ."
  },
  "devDependencies": {
    "@anthropic-ai/claude-code": "2.1.332",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "husky": "^9.1.7",
    "semver": "^7.8.6"
  }
}
